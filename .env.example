# Local server
PORT=8787
DATA_DIR=.data-local
APP_BASE_URL=http://127.0.0.1:8787
APPROVAL_TOKEN=replace-with-a-random-local-token
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret

# Local dashboard
PATCHPILOT_API_TARGET=http://127.0.0.1:8787
VITE_PATCHPILOT_API_URL=

# Live GitHub intake
GITHUB_TOKEN=
PATCHPILOT_REQUIRE_TRIGGER_LABEL=true
PATCHPILOT_TRIGGER_LABEL=patchpilot:run

# PatchPilot's own coding-agent harness (packages/agent)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
MCP_AUTH_TOKEN=

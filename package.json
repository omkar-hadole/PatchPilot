{
  "name": "patchpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "dev": "pnpm --filter @patchpilot/web dev",
    "lint": "pnpm -r --workspace-concurrency=1 lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "start": "pnpm --filter @patchpilot/server start",
    "verify": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "smoke-test": "node --experimental-strip-types scripts/smoke-test.ts"
  },
  "dependencies": {
    "@patchpilot/agent": "workspace:*",
    "@patchpilot/github": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
